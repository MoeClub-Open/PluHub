{
  "schemaVersion": 1,
  "dataDir": ".pluhub/data",
  "drainTimeoutMs": 30000,
  "plugins": [
    {
      "path": "../PluHub-Plugins/plugins/listener",
      "grants": [
        "http.listen"
      ],
      "config": {
        "port": 8080,
        "host": "127.0.0.1"
      }
    },
    {
      "path": "../PluHub-Plugins/plugins/http-transport",
      "grants": [],
      "config": {}
    },
    {
      "path": "../PluHub-Plugins/plugins/console",
      "grants": [
        "http.route"
      ],
      "config": {}
    },
    {
      "path": "../PluHub-Plugins/plugins/users",
      "grants": [
        "api.register"
      ],
      "config": {}
    },
    {
      "path": "../PluHub-Plugins/plugins/auth",
      "grants": [
        "api.register",
        "identity.provide",
        "hooks.register"
      ],
      "config": {}
    },
    {
      "path": "../PluHub-Plugins/plugins/ai-router",
      "grants": [
        "api.register",
        "http.route"
      ],
      "config": {
        "upstreams": {},
        "models": {}
