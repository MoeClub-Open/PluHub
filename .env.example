PLUHUB_BIND_ADDRESS=127.0.0.1
PLUHUB_PORT=8080
PLUHUB_PUBLIC_ORIGIN=http://localhost:8080
# Upstream keys are runtime-only; never put them in a Dockerfile or image.
OPENAI_API_KEY=
# Optional: configure its env reference in the provider plugin > OAuth settings.
ANTIGRAVITY_OAUTH_CLIENT_SECRET=

# Optional: authoritative online plugin registry; unset uses the bundled release snapshot.
# PLUHUB_OFFICIAL_REGISTRY_URL=https://registry.example.com/registry/v1/index.json
