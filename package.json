{
  "name": "pluhub-workspace",
  "private": true,
  "version": "0.1.0-alpha.13",
  "type": "module",
  "packageManager": "pnpm@10.20.0",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "build": "pnpm -r --workspace-concurrency=1 build",
    "typecheck": "pnpm -r --workspace-concurrency=1 typecheck",
    "test": "vitest run",
    "check": "pnpm typecheck && pnpm build && pnpm test",
    "dev": "node apps/cli/dist/index.js start",
    "demo": "node scripts/demo.mjs",
    "bootstrap": "node scripts/workspace.mjs bootstrap",
    "build:all": "node scripts/workspace.mjs build",
    "test:all": "node scripts/workspace.mjs test",
    "test:docker": "node scripts/verify-docker.mjs",
    "test:live": "node scripts/verify-live-gateway.mjs",
    "test:live:byo": "node scripts/verify-live-byo.mjs",
    "bench": "node scripts/bench.mjs",
    "pack:all": "node scripts/pack.mjs",
    "format": "prettier --write packages apps tests scripts deploy vitest.config.ts compose.yaml",
    "format:check": "prettier --check packages apps tests scripts deploy vitest.config.ts compose.yaml"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/semver": "7.8.0",
    "@types/ws": "8.18.2",
    "esbuild": "0.28.2",
    "prettier": "3.9.10",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "typescript": "5.9.3",
    "vitest": "4.1.12",
    "ws": "8.22.0"
  }
}
