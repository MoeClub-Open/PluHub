{
  "name": "pluhub-workspace",
  "private": true,
  "version": "0.1.0-alpha.22",
  "type": "module",
  "packageManager": "pnpm@10.20.0",
  "engines": {
    "node": ">=24 <25",
    "bun": ">=1.4.3 <1.5"
  },
  "scripts": {
    "build": "pnpm -r --workspace-concurrency=1 build",
    "typecheck": "pnpm -r --workspace-concurrency=1 typecheck",
    "test": "bun --bun node_modules/vitest/vitest.mjs run",
    "check": "pnpm typecheck && pnpm build && pnpm test",
    "dev": "bun apps/cli/dist/index.js start",
    "demo": "bun scripts/demo.ts",
    "bootstrap": "node scripts/workspace.ts bootstrap",
    "build:all": "node scripts/workspace.ts build",
    "test:all": "node scripts/workspace.ts test",
    "test:docker": "node scripts/verify-docker.ts",
    "test:live": "bun scripts/verify-live-gateway.ts",
    "test:live:byo": "bun scripts/verify-live-byo.ts",
    "bench": "bun scripts/bench.ts",
    "pack:all": "node scripts/pack.ts",
    "format": "prettier --write packages apps tests scripts deploy vitest.config.ts compose.yaml",
    "format:check": "prettier --check packages apps tests scripts deploy vitest.config.ts compose.yaml"
  },
  "devDependencies": {
    "@pluhub/contracts": "link:../PluHub-Spec",
    "@pluhub/control": "workspace:*",
    "@pluhub/sdk": "workspace:*",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/semver": "7.8.0",
    "@types/ws": "8.18.2",
    "esbuild": "0.28.2",
    "prettier": "3.9.10",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "typescript": "5.9.3",
    "vitest": "5.0.5",
    "ws": "8.22.0"
  }
}
